# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: Shared password required to open the platform.
# The gate is disabled (nobody can sign in) until this is set.
APP_PASSWORD="MY_APP_PASSWORD"

# APP_SESSION_SECRET: Signing key for session cookies.
# Optional - if unset, a random key is generated at each boot, which
# signs everyone out whenever the server restarts.
# Generate one with: openssl rand -hex 32
APP_SESSION_SECRET="MY_APP_SESSION_SECRET"

# ---------------------------------------------------------------------
# Firestore sync (optional). Without these the platform runs exactly as
# before, storing records in the browser only.
#
# From the Firebase console: Project settings > Service accounts >
# Generate new private key. Use the values from that JSON file.
# Create the Firestore database in the asia-southeast2 (Jakarta) region.
# ---------------------------------------------------------------------
FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
FIREBASE_CLIENT_EMAIL="MY_SERVICE_ACCOUNT_EMAIL"
# Keep the surrounding quotes and the literal \n sequences from the JSON file.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMY_KEY\n-----END PRIVATE KEY-----\n"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
