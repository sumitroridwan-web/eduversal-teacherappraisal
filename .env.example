# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_PASSWORD: Shared password required to open the platform.
# The gate is disabled (nobody can sign in) until this is set.
APP_PASSWORD="MY_APP_PASSWORD"

# APP_SESSION_SECRET: Signing key for session cookies.
# Optional - if unset, a random key is generated at each boot, which
# signs everyone out whenever the server restarts.
# Generate one with: openssl rand -hex 32
APP_SESSION_SECRET="MY_APP_SESSION_SECRET"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
